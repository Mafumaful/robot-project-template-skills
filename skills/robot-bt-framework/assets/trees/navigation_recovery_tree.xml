<?xml version="1.0"?>
<root BTCPP_format="3" main_tree_to_execute="HpaExternalBlockRecovery">
  <BehaviorTree ID="HpaExternalBlockRecovery">
    <Sequence name="HandleExternalHpaBlock">
      <CanHandleExternalHpaBlock
        session="{hpa_session}"
        pending="{external_block_pending}"/>
      <CancelHpaSegment
        session="{hpa_session}"
        server_name="{execute_hpa_segment_action}"/>
      <WaitUntilStopped timeout_sec="5.0" failure_context="{failure_context}"/>
      <CaptureBlockedRoadImage
        service_name="/analysis_camera"
        timeout_sec="5.0"
        image_path="{blocked_image_path}"
        vlm_response="{vlm_response}"
        capture_success="{capture_success}"
        capture_diagnostic="{capture_diagnostic}"/>
      <RunNavigationVlm
        vlm_response="{vlm_response}"
        vlm_result="{vlm_result}"
        navigation_context="{navigation_context}"/>
      <AnnounceBlockedRoad
        vlm_result="{vlm_result}"
        topic="{navigation_announcement_topic}"/>
      <Fallback name="ApplyExternalBlockVerdict">
        <Sequence name="ReplanAroundConfirmedBlock">
          <IsVlmBlocked vlm_result="{vlm_result}"/>
          <RecordExternalHpaBlock
            session="{hpa_session}"
            vlm_result="{vlm_result}"
            pending="{external_block_pending}"/>
          <ReplanHpaRoute
            session="{hpa_session}"
            phase="{hpa_phase}"
            detail="{hpa_detail}"
            replan_attempt="{hpa_replan_attempt}"/>
          <AcquireHpaRobotPose
            session="{hpa_session}"
            map_frame="{navigation_frame_id}"
            robot_frame="base_link"
            timeout_sec="2.0"
            phase="{hpa_phase}"
            detail="{hpa_detail}"/>
          <PlanHpaRoute
            session="{hpa_session}"
            service_name="/hpa_planner/plan_path"
            timeout_sec="10.0"
            planning_result="{planning_result}"
            phase="{hpa_phase}"
            detail="{hpa_detail}"
            route_revision="{route_revision}"/>
          <WaitForHpaCostmap
            session="{hpa_session}"
            topic="/local_costmap/costmap_raw"
            timeout_sec="40.0"
            allow_timeout="true"
            phase="{hpa_phase}"
            detail="{hpa_detail}"/>
        </Sequence>
        <ClearExternalHpaBlock
          session="{hpa_session}"
          pending="{external_block_pending}"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>
</root>
