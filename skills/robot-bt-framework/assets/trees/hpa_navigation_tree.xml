<?xml version="1.0"?>
<root BTCPP_format="3" main_tree_to_execute="HpaNavigationMission">
  <BehaviorTree ID="HpaNavigationMission">
    <Sequence name="ProductionHpaNavigation">
      <InitializeHpaExecution
        goal="{hpa_goal}"
        max_replan_attempts="{nav_retry_max}"
        session="{hpa_session}"
        phase="{hpa_phase}"
        detail="{hpa_detail}"/>
      <AcquireHpaRobotPose
        session="{hpa_session}"
        map_frame="{navigation_frame_id}"
        robot_frame="base_link"
        timeout_sec="2.0"
        pose="{hpa_start}"
        phase="{hpa_phase}"
        detail="{hpa_detail}"/>
      <PlanHpaRoute
        session="{hpa_session}"
        service_name="/hpa_planner/plan_path"
        timeout_sec="10.0"
        planning_result="{planning_result}"
        phase="{hpa_phase}"
        detail="{hpa_detail}"
        route_revision="{route_revision}"/>
      <WaitForHpaCostmap
        session="{hpa_session}"
        topic="/local_costmap/costmap_raw"
        timeout_sec="40.0"
        allow_timeout="true"
        phase="{hpa_phase}"
        detail="{hpa_detail}"/>
      <SubTreePlus
        ID="ExecuteRouteSegments"
        blocked_image_path="{blocked_image_path}"
        capture_diagnostic="{capture_diagnostic}"
        capture_success="{capture_success}"
        execute_hpa_segment_action="{execute_hpa_segment_action}"
        external_block_pending="{external_block_pending}"
        failure_context="{failure_context}"
        hpa_detail="{hpa_detail}"
        hpa_navigation_time_sec="{hpa_navigation_time_sec}"
        hpa_operation="{hpa_operation}"
        hpa_outcome="{hpa_outcome}"
        hpa_phase="{hpa_phase}"
        hpa_replan_attempt="{hpa_replan_attempt}"
        hpa_session="{hpa_session}"
        arrival_verified="{arrival_verified}"
        position_error="{position_error}"
        yaw_error="{yaw_error}"
        stable_samples_required="{stable_samples_required}"
        stable_samples="{stable_samples}"
        arrival_reason="{arrival_reason}"
        navigation_distance_remaining="{navigation_distance_remaining}"
        navigation_announcement_topic="{navigation_announcement_topic}"
        navigation_context="{navigation_context}"
        navigation_frame_id="{navigation_frame_id}"
        planning_result="{planning_result}"
        route_revision="{route_revision}"
        vlm_response="{vlm_response}"
        vlm_result="{vlm_result}"
        waypoint_task_timeout_sec="{waypoint_task_timeout_sec}"/>
    </Sequence>
  </BehaviorTree>
</root>
